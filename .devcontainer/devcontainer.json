{
  "name": "App modernisation workshop",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "features": {
    "ghcr.io/devcontainers/features/java:latest": {
      "version": "8",
      "additionalVersions": "21,25",
      "jdkDistro": "tem"
    },
    "ghcr.io/devcontainers/features/dotnet:latest": {
      "version": "10.0"
    },
    "ghcr.io/devcontainers/features/node:latest": {
      "version": "22",
      "nodeGypDependencies": false,
      "pnpmVersion": "none"
    },
    "ghcr.io/devcontainers/features/azure-cli:latest": {},
    "ghcr.io/azure/azure-dev/azd:latest": {},
    "ghcr.io/devcontainers/features/docker-in-docker:latest": {}
  },
  "containerEnv": {
    "WORKSHOP_DEVCONTAINER": "1",
    "AZD_CONTAINER_RUNTIME": "docker"
  },
  "remoteUser": "vscode",
  "init": true,
  "forwardPorts": [8080, 15672],
  "portsAttributes": {
    "8080": {
      "label": "Asset Manager",
      "onAutoForward": "notify"
    },
    "15672": {
      "label": "RabbitMQ management",
      "onAutoForward": "notify"
    }
  },
  "postCreateCommand": ["az", "extension", "add", "--name", "containerapp", "--yes"]
}
